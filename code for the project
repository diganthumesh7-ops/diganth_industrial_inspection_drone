fprintf('  Rise Time           = %.2f sec\n', metrics_dist.RiseTime);
fprintf('  Settling Time       = %.2f sec\n', metrics_dist.SettlingTime);
fprintf('  Steady-State Error  = %.4f\n', metrics_dist.SSE);

