fprintf('====================================================\n');

%% =========================================================
% PLANT MODEL
% G(s) = 1 / (s^2 + 2s + 5)
%% =========================================================

s = tf('s');
G = 1/(s^2 + 2*s + 5);

disp('Open Loop Transfer Function:')
G

figure;
step(G);
grid on;
title('Open Loop Step Response');

%% =========================================================
% SIMULATION SETUP
%% =========================================================

dt   = 0.01;
Tend = 20;
t    = 0:dt:Tend;
N    = numel(t);

ref = ones(1, N);

% Industrial disturbance profile: wind gusts near towers
disturbance = zeros(1, N);
disturbance(t >= 4  & t < 6)  = 0.30;
disturbance(t >= 9  & t < 11) = 0.60;
disturbance(t >= 14 & t < 16) = 0.90;

figure;
plot(t, disturbance, 'LineWidth', 2);
grid on;
title('Industrial Disturbance Profile');
xlabel('Time (s)');
ylabel('Disturbance Magnitude');

%% =========================================================
% FIXED PID BASELINE
%% =========================================================

Kp_fixed = 25;
Ki_fixed = 12;
Kd_fixed = 6;

C_fixed = pid(Kp_fixed, Ki_fixed, Kd_fixed);
disp('Fixed PID Controller:')
C_fixed

T_fixed = feedback(C_fixed * G, 1);

figure;
step(T_fixed, t);
grid on;
title('Closed Loop Step Response with Fixed PID');

info_fixed = stepinfo(T_fixed);

fprintf('\n================ FIXED PID METRICS ================\n');
fprintf('Overshoot      : %.2f %%\n', info_fixed.Overshoot);
fprintf('Rise Time      : %.2f sec\n', info_fixed.RiseTime);
fprintf('Settling Time  : %.2f sec\n', info_fixed.SettlingTime);

%% =========================================================
% ADAPTIVE PID SIMULATION - NO DISTURBANCE
% This gives clean controller metrics
%% =========================================================

[y_adapt_clean, u_adapt_clean, Kp_hist_clean, Ki_hist_clean, Kd_hist_clean] = ...
    simulateAeroGuard('adaptive', t, dt, zeros(1, N));

metrics_clean = calcMetrics(t, y_adapt_clean, ref);

%% =========================================================
% ADAPTIVE PID SIMULATION - WITH DISTURBANCE
%% =========================================================

[y_adapt_dist, u_adapt_dist, Kp_hist, Ki_hist, Kd_hist] = ...
    simulateAeroGuard('adaptive', t, dt, disturbance);

metrics_dist = calcMetrics(t, y_adapt_dist, ref);

%% =========================================================
% FIXED PID SIMULATION - WITH DISTURBANCE
%% =========================================================

[y_fixed_dist, u_fixed_dist] = ...
    simulateAeroGuard('fixed', t, dt, disturbance);

metrics_fixed_dist = calcMetrics(t, y_fixed_dist, ref);

%% =========================================================
% PERFORMANCE COMPARISON
%% =========================================================

fprintf('\n================ PERFORMANCE COMPARISON ================\n');

fprintf('Fixed PID (with disturbance):\n');
fprintf('  Overshoot           = %.2f %%\n', metrics_fixed_dist.Overshoot);
fprintf('  Rise Time           = %.2f sec\n', metrics_fixed_dist.RiseTime);
fprintf('  Settling Time       = %.2f sec\n', metrics_fixed_dist.SettlingTime);
fprintf('  Steady-State Error  = %.4f\n', metrics_fixed_dist.SSE);

fprintf('\nAdaptive PID (clean, no disturbance):\n');
fprintf('  Overshoot           = %.2f %%\n', metrics_clean.Overshoot);
fprintf('  Rise Time           = %.2f sec\n', metrics_clean.RiseTime);
fprintf('  Settling Time       = %.2f sec\n', metrics_clean.SettlingTime);
fprintf('  Steady-State Error  = %.4f\n', metrics_clean.SSE);

fprintf('\nAdaptive PID (with disturbance):\n');
