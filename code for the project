%% =========================================================
% LOCAL FUNCTIONS
%% =========================================================

function [y, u, Kp_hist, Ki_hist, Kd_hist] = simulateAeroGuard(mode, t, dt, disturbance)
    % Drone state-space model
    A = [0 1; -5 -2];
    B = [0; 1];
    Cmat = [1 0];

    N = numel(t);
    ref = ones(1, N);

    % Simulation settings
    noiseAmp = 0.01;
    uMax = 10;
    alpha = 0.85;

    % Initial state
    x = [0; 0];

    % Output arrays
    y = zeros(1, N);
    u = zeros(1, N);

    Kp_hist = zeros(1, N);
    Ki_hist = zeros(1, N);
    Kd_hist = zeros(1, N);

    % Controller memory
    eInt = 0;
    ePrev = 0;
    dFilt = 0;

    for k = 1:N
        % Sensor measurement with noise
        yMeas = Cmat * x + noiseAmp * randn;
        e = ref(k) - yMeas;

        de = (e - ePrev) / dt;
        dFilt = alpha * dFilt + (1 - alpha) * de;

        % Controller selection
        if strcmp(mode, 'fixed')
            Kp = 25;
            Ki = 12;
            Kd = 6;
        else
            % Adaptive disturbance classification
            dNow = abs(disturbance(k));

            if dNow < 0.20
                Kp = 20;
                Ki = 10;
                Kd = 5;
            elseif dNow < 0.70
                Kp = 28;
                Ki = 10;
                Kd = 6;
            else
                Kp = 34;
                Ki = 12;
                Kd = 8;
            end

            % Emergency stabilization mode
            if abs(e) > 0.8
                Kp = Kp + 3;
                Kd = Kd + 1;
            end
        end

        Kp_hist(k) = Kp;
        Ki_hist(k) = Ki;
        Kd_hist(k) = Kd;

        % PID control
        uUnsat = Kp * e + Ki * eInt + Kd * dFilt;

        % Saturation
        uSat = max(min(uUnsat, uMax), -uMax);
        u(k) = uSat;

        % Anti-windup
        if abs(uSat - uUnsat) < 1e-9 || sign(e) ~= sign(uUnsat - uSat)
            eInt = eInt + e * dt;
        end

        % Plant update
        xDot = A * x + B * (uSat + disturbance(k));
        x = x + dt * xDot;

        % Store true output
        y(k) = Cmat * x;

        ePrev = e;
    end
end

function m = calcMetrics(t, y, ref)
    yFinal = ref(end);

    % Overshoot
    peakVal = max(y);
    m.Overshoot = max(0, (peakVal - yFinal) / abs(yFinal) * 100);

    % Rise time (10% to 90%)
    idx10 = find(y >= 0.1 * yFinal, 1, 'first');
    idx90 = find(y >= 0.9 * yFinal, 1, 'first');

    if isempty(idx10) || isempty(idx90)
        m.RiseTime = NaN;
    else
        m.RiseTime = t(idx90) - t(idx10);
    end

    % Settling time (2% band)
    band = 0.02 * abs(yFinal);
    idxOutside = find(abs(y - yFinal) > band, 1, 'last');

    if isempty(idxOutside)
        m.SettlingTime = 0;
    elseif idxOutside == numel(t)
        m.SettlingTime = NaN;
    else
        m.SettlingTime = t(idxOutside + 1);
    end

    % Steady-state error
    m.SSE = abs(yFinal - y(end));
end
